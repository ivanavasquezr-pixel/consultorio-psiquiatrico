# ============================================================
# Configuración del servidor
# ============================================================
PORT=3000
NODE_ENV=development
# Orígenes permitidos separados por comas. Usa * para permitir todos.
CORS_ORIGIN=*

# ============================================================
# Conexión a MySQL en Railway
# Copia estos valores desde la pestaña "Connect" del servicio
# de MySQL en Railway o desde la sección "Variables".
# Si ejecutas base_de_datos.sql completo, usa
# DB_NAME=consultorio_psicologico. Si utilizas la base de datos
# existente de Railway, usa su nombre (normalmente railway).
# ============================================================
DB_HOST=tu-host.railway.app
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu-contraseña
DB_NAME=consultorio_psicologico

# Usa true si el proveedor exige una conexión cifrada (SSL/TLS).
DB_SSL=false

# Límite de conexiones simultáneas del grupo de conexiones.
DB_CONNECTION_LIMIT=10

# Tiempo máximo de espera para conectar a MySQL, en milisegundos.
DB_CONNECT_TIMEOUT=10000

# ============================================================
# Alternativa para Railway (opcional)
# Si defines MYSQLHOST, se usarán las variables MYSQL*.
# Railway también puede proporcionar MYSQL_URL o DATABASE_URL.
# ============================================================
# MYSQLHOST=tu-host.railway.app
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=tu-contraseña
# MYSQLDATABASE=railway
# MYSQL_URL=mysql://usuario:contraseña@host:puerto/base_de_datos
