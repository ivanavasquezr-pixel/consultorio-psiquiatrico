# ============================================================
# Configuración del servidor
# ============================================================
PORT=3000
NODE_ENV=development
# Orígenes permitidos separados por comas. Usa * para permitir todos.
CORS_ORIGIN=*

# ============================================================
# Conexión a MySQL en Railway
# Copia estos valores desde la pestaña "Connect" del servicio
# de MySQL en Railway o desde la sección "Variables".
#
# Si la API corre en Render, usa el host y el puerto PÚBLICOS
# del TCP Proxy (por ejemplo junction.proxy.rlwy.net:26123).
# El host interno *.railway.internal solo funciona dentro de
# Railway. Habilita el TCP Proxy en Settings > Networking.
#
# Si ejecutas base_de_datos.sql completo, usa
# DB_NAME=consultorio_psicologico. Si utilizas la base de datos
# existente de Railway, usa su nombre (normalmente railway).
# ============================================================
DB_HOST=tu-host-publico.proxy.rlwy.net
DB_PORT=26123
DB_USER=root
DB_PASSWORD=tu-contraseña
DB_NAME=consultorio_psicologico

# Usa true si el proveedor exige una conexión cifrada (SSL/TLS).
# Para el TCP Proxy de Railway normalmente se usa false.
DB_SSL=false

# Límite de conexiones simultáneas del grupo de conexiones.
DB_CONNECTION_LIMIT=10

# Tiempo máximo de espera para conectar a MySQL, en milisegundos.
DB_CONNECT_TIMEOUT=10000

# ============================================================
# Alternativas de configuración (opcional)
# Orden de prioridad: DB_* > URL completa > MYSQL*.
# Railway también puede proporcionar MYSQL_URL, MYSQL_PUBLIC_URL
# o DATABASE_URL.
# ============================================================
# DB_URL=mysql://usuario:contraseña@host-publico.proxy.rlwy.net:26123/base_de_datos
# MYSQL_PUBLIC_URL=mysql://usuario:contraseña@host-publico.proxy.rlwy.net:26123/base_de_datos
# MYSQLHOST=tu-host-publico.proxy.rlwy.net
# MYSQLPORT=26123
# MYSQLUSER=root
# MYSQLPASSWORD=tu-contraseña
# MYSQLDATABASE=railway
# MYSQL_URL=mysql://usuario:contraseña@host:puerto/base_de_datos
